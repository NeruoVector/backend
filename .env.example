# 복사해서 .env 로 사용하세요: cp .env.example .env
LISTEN_ADDR=0.0.0.0:8081
PUBLIC_BASE_URL=http://localhost:8081

# platform 레포의 compose.yaml 과 동일한 값
DATABASE_URL=postgres://neurovector:neurovector@localhost:5432/neurovector
DATABASE_MAX_CONNECTIONS=10

REDIS_URL=redis://:neurovector@localhost:6379/0
# Redis 연결 및 응답 제한 시간 (ms)
REDIS_TIMEOUT_MS=500

# Redis cache-aside (주문/재고/관리자 조회)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_EVENTS=neurovector.events
# 주문 비동기 생성 + 주문/결제 이벤트 큐
KAFKA_TOPIC_ORDERS=neurovector.orders

# ---- 관리자 세션 로그인 ----
# 최초 기동 시 이 계정이 생성됩니다. 비밀번호를 바꾸면 기존 세션이 폐기됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=neurovector-admin
ADMIN_SESSION_TTL_SECONDS=86400
# HTTPS 배포 시 true 로 설정하세요.
ADMIN_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# MQTT (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=neurovector
MQTT_PASSWORD=neurovector
MQTT_CLIENT_ID=neurovector-backend
MQTT_TOPIC_PREFIX=neurovector
MQTT_QOS=1

# MediaMTX (SRT + WebRTC/WHEP + recordings)
MEDIA_API_BASE_URL=http://localhost:9997
MEDIA_WHEP_BASE_URL=http://localhost:8889
MEDIA_SRT_PUBLIC_HOST=localhost
MEDIA_SRT_PORT=8890
MEDIA_RECORDINGS_DIR=./recordings

# 경로 검증 / 위험 예측
MAX_ALTITUDE_M=120
ROUTE_MAX_LEG_M=5000
ROUTE_MAX_DISTANCE_M=20000
ROUTE_BATTERY_WH=500
ROUTE_POWER_W=300
RISK_LOOKBACK_DAYS=90
RISK_CORRIDOR_M=150
TELEMETRY_ONLINE_TTL_SECONDS=120

RUST_LOG=info,tower_http=debug
